<script>
export default {
  name: 'LandingPage',
  data() {
    return {
      apkUrl: process.env.VUE_APP_BASE_API + '/app/download',
      // 蒲公英下载链接，上传APK到蒲公英后替换此链接
      // 格式：https://www.pgyer.com/xxxxx
      pgyerUrl: 'https://www.pgyer.com/zhicunwms',  // 蒲公英下载链接
      mobileMenuOpen: false  // 移动端菜单展开状态
    }
  },
  computed: {
    qrCodeUrl() {
      // 如果有蒲公英链接，用蒲公英链接；否则用本地下载页
      const url = this.pgyerUrl !== 'https://www.pgyer.com/'
        ? this.pgyerUrl
        : window.location.origin + '/download'
      return `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(url)}`
    }
  },
  methods: {
    toggleMobileMenu() {
      this.mobileMenuOpen = !this.mobileMenuOpen
    },
    closeMobileMenu() {
      this.mobileMenuOpen = false
    }
  }
}
</script>

